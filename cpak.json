{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Flameshot",
  "description": "Capture, annotate and share screenshots.",
  "version": "14.0.0",
  "image": "ghcr.io/containerpak/flameshot@sha256:c3966dcf08d301401ac1b4ae9d6709a82d38205e8a4687e54cb80e3c414f3be1",
  "binaries": [
    "/usr/bin/flameshot"
  ],
  "desktop_entries": [
    "/usr/share/applications/org.flameshot.Flameshot.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
